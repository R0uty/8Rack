# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Exec tool workspace (read_file/write_file/bash/etc. sandbox root) - runtime scratch space
backend/workspace/*
!backend/workspace/.gitkeep
!backend/workspace/wordlists/

# User-created missions (tool execution + orchestrator task history) - runtime data, not shipped
# config like backend/data/agents/*.json, and mission notes may contain sensitive target/scope info
backend/data/missions/*
!backend/data/missions/.gitkeep

# RAG knowledge base index (embedded chunks of the workspace codebase) - runtime data, and its
# content could reflect proprietary/sensitive code from WORKSPACE_ROOT
backend/data/rag/*
!backend/data/rag/.gitkeep

# Tool Registry enable/disable overrides - runtime state, not shipped config
backend/data/tools/*
!backend/data/tools/.gitkeep

# MCP tool enable/disable overrides - runtime state, not shipped config
backend/data/mcp/*
!backend/data/mcp/.gitkeep

# Python MCP servers' own virtualenvs and runtime data
mcp-servers/*/.venv/
mcp-servers/*/data/
mcp-servers/**/__pycache__/
mcp-servers/**/*.egg-info/

# start.sh's own tracked dev-server PIDs - runtime state, not shipped
.backend.pid
.frontend.pid

# Env files
.env
.env.local
!.env.example

# Logs
logs
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

*.local
*.suo

# graphify skill output - local knowledge-graph artifacts, not shipped
graphify-out/
*.ntvs*
*.njsproj
*.sln
*.sw?
