# The RAG MCP server's settings - copy to .env (gitignored). Variables already set in the environment
# win over this file.

# Required. The bearer token 8Rack must send - put the same value in backend/.env as MCP_TOKEN_RAG.
# At least 16 characters; generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_MCP_TOKEN=

# Required. The folder to index - usually the same as the backend's WORKSPACE_ROOT.
RAG_WORKSPACE_ROOT=

# Optional. The server always listens on 127.0.0.1 only.
RAG_PORT=8766

# Optional. Where the index is saved (default data/index.json next to this file, gitignored).
# RAG_INDEX_FILE=

# Optional. Embeddings come from local Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_S=60
