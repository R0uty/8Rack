# The tools MCP server's settings - copy to .env (gitignored). Variables already set in the
# environment win over this file.

# Required. The bearer token 8Rack must send - put the same value in backend/.env as MCP_TOKEN_<ID>
# for this server. At least 16 characters; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOOLS_MCP_TOKEN=

# Required. The folder tools run in (their cwd) and the root that path-shaped arguments are confined
# to. The server owns path containment for its own filesystem.
TOOLS_WORKSPACE_ROOT=

# Optional. Where uvicorn binds. Default loopback. Set to the interface 8Rack reaches this host
# through for a real scanning host. A non-loopback bind must serve HTTPS - see the TLS settings below.
TOOLS_MCP_HOST=127.0.0.1

# Optional. The Host header the DNS-rebinding guard accepts - the name 8Rack connects by. Defaults to
# TOOLS_MCP_HOST; set it when a TLS-terminating proxy with a different public hostname fronts a
# loopback bind.
# TOOLS_MCP_ALLOWED_HOST=

# Optional.
TOOLS_MCP_PORT=8767

# Optional. Default per-command timeout in seconds (each tool may set its own). Output over
# TOOLS_MAX_OUTPUT_BYTES per stream is truncated.
TOOLS_COMMAND_TIMEOUT_S=300
TOOLS_MAX_OUTPUT_BYTES=1000000

# Optional. Serve HTTPS directly by pointing these at a cert/key pair (set both or neither). Required
# for a non-loopback bind, unless a TLS-terminating proxy sits in front (then set
# TOOLS_MCP_BEHIND_TLS_PROXY=1 instead and leave these blank).
# TOOLS_MCP_TLS_CERTFILE=
# TOOLS_MCP_TLS_KEYFILE=
# TOOLS_MCP_BEHIND_TLS_PROXY=0
