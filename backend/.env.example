PORT=3001
OLLAMA_BASE_URL=http://localhost:11434
CORS_ORIGIN=http://localhost:5173

# Root directory exec tools (read_file, write_file, list_directory, search_files, grep, bash,
# python, git, etc.) are confined to. Created automatically on startup if missing. Defaults to
# backend/workspace.
WORKSPACE_ROOT=

# Orchestrator loop-prevention caps (see backend/src/services/orchestrator.ts).
MAX_ORCHESTRATOR_TOOL_CALLS=10
MAX_ORCHESTRATOR_TASK_TIME_MS=600000
