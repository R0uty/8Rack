PORT=3001
OLLAMA_BASE_URL=http://localhost:11434
CORS_ORIGIN=http://localhost:5173

# Interface the backend binds to. Defaults to loopback-only (127.0.0.1) - there's no auth on this
# app by design, so every tool-execution/scan/orchestrator endpoint would otherwise be reachable
# from anything else on the same network (CORS_ORIGIN only restricts browser cross-origin fetches,
# not a raw request from another device). Set to 0.0.0.0 only if you deliberately want LAN access
# and understand the tradeoff.
HOST=127.0.0.1

# DNS-rebinding defense: a Host-header allowlist checked on every request, since CORS_ORIGIN alone
# doesn't stop a malicious page's short-TTL DNS record from making itself same-origin to
# 127.0.0.1. Defaults to localhost/127.0.0.1/[::1] on the configured PORT when HOST is left at its
# default; not enforced at all when HOST is set to anything else (already an informed opt-in to
# wider exposure). Only set this if the default allowlist is wrong for your setup, e.g. a reverse
# proxy fronting this server under another hostname. Comma-separated, each including its port.
ALLOWED_HOSTS=

# Root directory exec tools (read_file, write_file, list_directory, search_files, grep, bash,
# python, git, etc.) are confined to. Also the folder the RAG knowledge base indexes (see
# EMBEDDING_MODEL below). Created automatically on startup if missing. Defaults to backend/workspace.
WORKSPACE_ROOT=

# Orchestrator loop-prevention caps (see backend/src/services/orchestrator.ts).
MAX_ORCHESTRATOR_TOOL_CALLS=10
MAX_ORCHESTRATOR_TASK_TIME_MS=600000

# Model used to embed the RAG knowledge base (see backend/src/services/ragIndex.ts). Must be a
# model with Ollama's "embedding" capability - most chat/coder models don't have it and Ollama's
# /api/embed rejects them outright. Pull it first: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Optional NVD API key (see backend/src/services/cveLookup.ts) - CVE lookups work fine unauthenticated
# at 5 req/30s if left blank; a free key (https://nvd.nist.gov/developers/request-an-api-key) raises
# that to 50 req/30s. This is the only outbound internet call 8Rack ever makes, and only on-demand
# when a user or agent explicitly requests a CVE lookup.
NVD_API_KEY=

# Outbound request timeouts - guard against a hung connection blocking a request indefinitely.
# NVD_REQUEST_TIMEOUT_MS bounds the CVE-lookup call above. OLLAMA_REQUEST_TIMEOUT_MS bounds
# Ollama's quick, non-generation calls (/api/tags, /api/embed) - a wedged Ollama process (e.g. mid
# model-load) would otherwise hang these indefinitely. OLLAMA_CHAT_IDLE_TIMEOUT_MS bounds a
# streamed /api/chat generation by *inactivity*, not total duration - the timer resets on every
# token received, so a large local model that's still slowly producing output is never killed by
# this, only a connection that's gone genuinely silent.
NVD_REQUEST_TIMEOUT_MS=15000
OLLAMA_REQUEST_TIMEOUT_MS=60000
OLLAMA_CHAT_IDLE_TIMEOUT_MS=300000

# Global cap on real OS processes spawned at once via the Tool Execution Framework - shared across
# every caller (manual requests, Orchestrator tasks, Scan Profiles). Guards against fork/memory
# exhaustion from many confirmed executions landing at once. Not a queue - confirming beyond the
# cap fails fast with a clear error so the human can retry once a slot frees up.
MAX_CONCURRENT_EXECUTIONS=5
